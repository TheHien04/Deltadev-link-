{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": ["eslint:recommended"],
  "ignorePatterns": ["public/service-worker.js", "coverage/"],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "warn",
    "eqeqeq": ["error", "smart"],
    "prefer-const": "warn"
  },
  "overrides": [
    {
      "files": ["src/js/utils/logger.js"],
      "rules": { "no-console": "off" }
    }
  ]
}
