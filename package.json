{
  "name": "deltadev-link",
  "version": "3.2.1",
  "description": "DeltaDev Link — artisan sausages from the Mekong Delta. Static bilingual storefront with PWA support.",
  "type": "module",
  "main": "src/js/main.js",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "dev": "python3 -m http.server 8000",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src/js tests",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHien04/Deltadev-link-.git"
  },
  "homepage": "https://github.com/TheHien04/Deltadev-link-",
  "bugs": {
    "url": "https://github.com/TheHien04/Deltadev-link-/issues"
  },
  "keywords": [
    "lap-xuong",
    "vietnamese-food",
    "artisan-sausage",
    "pwa",
    "ecommerce",
    "mekong-delta"
  ],
  "author": "DeltaDev Link Team",
  "license": "MIT",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.0"
  }
}
